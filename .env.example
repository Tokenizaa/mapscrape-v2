# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MAPSCRAPE_API_BASE_URL: Base URL do serviço MapScrape para integração do consumidor.
# Configure no backend do projeto consumidor (NÃO no frontend).
# Exemplo: https://seu-mapscrape-deploy.vercel.app ou http://localhost:3000
MAPSCRAPE_API_BASE_URL="https://MINHUAPPS.myscrape.app"

# MAPSCRAPE_API_KEY: Chave de API individual do consumidor, obtida após o provisionamento.
# Esta variável deve ser usada exclusivamente no backend do projeto consumidor.
# Nunca comite esta chave no repositório ou a expõe no frontend.
# Obtenha-a chamando POST /api/v1/provisioning/credentials com o provisioning token.
MAPSCRAPE_API_KEY="MINHA_CHAVE_API_BELEZA_DIGITAL"
