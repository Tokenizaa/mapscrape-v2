{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.bundle.mjs",
    "start": "node --import tsx server.ts",
    "preview": "vite preview",
    "test": "vitest run --fileParallelism=false",
    "clean": "rm -rf dist server.js server.bundle.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "puppeteer": "^25.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "cookie": "^0.7.2",
    "ajv": "^8.17.1",
    "undici": "^6.28.1",
    "express": {
      "path-to-regexp": "0.1.13"
    }
  }
}
