{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    },
    "api/[...path].ts": {
      "maxDuration": 300
    },
    "api/v1/[...path].ts": {
      "maxDuration": 300
    },
    "api/scrape/start.ts": {
      "maxDuration": 300
    },
    "api/auth/login.ts": {
      "maxDuration": 60
    },
    "api/auth/register.ts": {
      "maxDuration": 60
    },
    "api/auth/me.ts": {
      "maxDuration": 30
    },
    "api/v1/provisioning/credentials.ts": {
      "maxDuration": 60
    },
    "api/v1/provisioning/credentials/[...path].ts": {
      "maxDuration": 60
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs"
}
