{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapscrape",
  "compatibility_date": "2026-10-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "pages_build_output_dir": "dist",
  "vars": {
    "MAPSCRAPE_API_VERSION": "v1"
  }
}
